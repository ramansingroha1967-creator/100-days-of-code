#include <stdio.h>
int main(){
    printf("Find the sum of all elements in a matrix.\n");
    int i,j,row,col,sum=0;
    printf("Enter the nth row= ");
    scanf("%d",&row);
    printf("Enter the nth coloum= ");
    scanf("%d",&col);
    int matrix[row][col];
    for (i = 0; i < row; i++)
    {
        for (j = 0; j < col; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }
    printf("Lets covert it into matrix\n");
    for (i = 0; i < row; i++)
    {
        for (j = 0; j < col; j++)
        {
            printf("%d ", matrix[i][j]);
        }
        printf("\n");
    }
    for (i = 0; i < row; i++)
    {
        for (j = 0; j < col; j++)
        {
            sum+=matrix[i][j];
        }
    }
    printf("sum = %d", sum);
return 0;
}
