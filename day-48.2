#include <stdio.h>
#include <string.h>

int main()
{
    char str[200];
    int i, start = 0, end;

    printf("Enter a sentence: ");
    fgets(str, 200, stdin);

    for (i = 0; str[i] != '\0'; i++)
    {
        // If space or newline is found
        if (str[i] == ' ' || str[i] == '\n')
        {
            end = i - 1;

            // Reverse the current word
            while (start < end)
            {
                char temp = str[start];
                str[start] = str[end];
                str[end] = temp;

                start++;
                end--;
            }

            // Start of next word
            start = i + 1;
        }
    }

    printf("After reversing each word: %s", str);

    return 0;
}
