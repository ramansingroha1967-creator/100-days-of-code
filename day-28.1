#include <stdio.h>
int main()
{
    printf("Write a program to print all the prime numbers from 1 to n.\n");
    int n, num, i, count;
    printf("enter the nth value = ");
    scanf("%d", &n);
    for (num = 2; num <= n; num++)
    {
        count = 0;
        for (i = 1; i <=num; i++)
        {

            if (num % i == 0)
            {
                count++;
            }
        }
        if (count == 2)
        {
            printf("%d\n", num);
        }
    }
    return 0;
}
