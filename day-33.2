#include <stdio.h>

int main()
{
    printf("Insert an element in a sorted array at the appropriate position.\n");

    int n, i, element;

    printf("Enter size of array: ");
    scanf("%d", &n);

    int arr[n + 1];

    printf("Enter sorted array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to insert: ");
    scanf("%d", &element);

    for(i = n - 1; i >= 0 && arr[i] > element; i--)
    {
        arr[i + 1] = arr[i];
    }

    arr[i + 1] = element;
    n++;

    printf("Array after insertion:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
