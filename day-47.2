```c
#include <stdio.h>

int main() {
    char str[200];
    char longest[100];
    int i, j = 0;
    int max = 0, count = 0;
    int start = 0;

    printf("Enter a sentence: ");
    fgets(str, 200, stdin);

    for (i = 0; ; i++) {

        if (str[i] != ' ' && str[i] != '\n' && str[i] != '\0') {
            count++;
        }
        else {
            if (count > max) {
                max = count;

                for (j = 0; j < count; j++) {
                    longest[j] = str[start + j];
                }

                longest[count] = '\0';
            }

            count = 0;
            start = i + 1;
        }

        if (str[i] == '\0') {
            break;
        }
    }

    printf("Longest word = %s\n", longest);

    return 0;
}
