#include <stdio.h>

int findEquilibriumIndex(int arr[], int n) {
    long long total_sum = 0;
    long long left_sum = 0;

    // Step 1: Compute total sum of all elements
    for (int i = 0; i < n; i++) {
        total_sum += arr[i];
    }

    // Step 2: Iterate and check for equilibrium condition
    for (int i = 0; i < n; i++) {
        // right_sum = total_sum - left_sum - arr[i]
        if (left_sum == (total_sum - left_sum - arr[i])) {
            return i; // Found equilibrium index
        }
        
        left_sum += arr[i];
    }

    return -1; // No equilibrium index exists
}

int main() {
    int arr[] = {-7, 1, 5, 2, -4, 3, 0};
    int n = sizeof(arr) / sizeof(arr[0]);

    int index = findEquilibriumIndex(arr, n);

    if (index != -1) {
        printf("Equilibrium Index is: %d (value = %d)\n", index, arr[index]);
    } else {
        printf("No Equilibrium Index found.\n");
    }

    return 0;
}
