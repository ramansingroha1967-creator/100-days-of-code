#include <stdio.h>
int main(){
    printf("Program to display the month name and number of days using switch-case for a given month number\n.");
    int day;
    printf("entre the no (1-12)= ");
    scanf("%d",&day);
    switch (day)
    {
    case 1:
        printf("January, no of days=31\n");
        break;
    case 2:
        printf("Febuary, no of days=28-29\n");
        break;
    case 3:
        printf("March, no of days=31\n");
        break;
    case 4:
        printf("April, no of days=30\n");
        break;
    case 5:
        printf("May, no of days=31\n");
        break;
    case 6:
        printf("June, no of days=30\n");
        break;
    case 7:
        printf("july, no of days=31\n");
        break;
    case 8:
        printf("August, no of days=31\n");
        break;
    case 9:
        printf("september, no of days=30\n");
        break;
    case 10:
        printf("octuber, no of days=31\n");
        break;
    case 11:
        printf("november, no of days=30\n");
        break;
    case 12:
        printf("December, no of days=31\n");
        break;
    default:
        printf("months are not more then 12 \n");
        break;
    }
return 0;
}
