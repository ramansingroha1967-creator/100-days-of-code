#include <stdio.h>
#include <string.h>

int firstNonRepeatingChar(const char str[]) {
    int freq[256] = {0};
    int len = strlen(str);

    // Pass 1: Build frequency table
    for (int i = 0; i < len; i++) {
        freq[(unsigned char)str[i]]++;
    }

    // Pass 2: Find the first character with frequency 1
    for (int i = 0; i < len; i++) {
        if (freq[(unsigned char)str[i]] == 1) {
            return i; // Return index of first non-repeating character
        }
    }

    return -1; // All characters repeat
}

int main() {
    char str[] = "swiss";

    int index = firstNonRepeatingChar(str);

    if (index != -1) {
        printf("First non-repeating character is '%c' at index %d\n", str[index], index);
    } else {
        printf("No non-repeating character found\n");
    }

    return 0;
}
