#include <stdio.h>
#include <stdlib.h>

void printSlidingWindowMax(const int arr[], int n, int k) {
    if (n == 0 || k <= 0 || k > n) {
        return;
    }

    // Allocate an array to function as a deque of indices
    int *deque = (int *)malloc(n * sizeof(int));
    if (deque == NULL) {
        fprintf(stderr, "Memory allocation failed.\n");
        return;
    }

    int front = 0;
    int rear = -1;

    for (int i = 0; i < n; i++) {
        // 1. Remove indices that fall outside the current sliding window [i - k + 1, i]
        while (front <= rear && deque[front] <= i - k) {
            front++;
        }

        // 2. Remove elements from the rear that are smaller than or equal to arr[i]
        // because they will never be the maximum in any future window containing arr[i]
        while (front <= rear && arr[deque[rear]] <= arr[i]) {
            rear--;
        }

        // 3. Add the current element's index to the rear
        deque[++rear] = i;

        // 4. Once we have processed at least k elements, the front of the deque
        // is always the maximum element for the window ending at index i
        if (i >= k - 1) {
            printf("%d", arr[deque[front]]);
            if (i < n - 1) {
                printf(" ");
            }
        }
    }
    printf("\n");

    free(deque);
}

int main(void) {
    int n, k;

    // Read array size n and window size k
    if (scanf("%d %d", &n, &k) != 2) {
        return 0;
    }

    int *arr = (int *)malloc(n * sizeof(int));
    if (arr == NULL) {
        return 1;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printSlidingWindowMax(arr, n, k);

    free(arr);
    return 0;
}
