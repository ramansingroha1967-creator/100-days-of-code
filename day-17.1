#include <stdio.h>
#include <math.h>
int main()
{
    printf("Write a program to check if a number is an Armstrong number.\n");
    int num, orignal, digits = 0;
    int digit, temp, sum = 0;
    printf("enter any number=");
    scanf("%d", &num);

    orignal = num;

    temp = num;
    while (temp > 0)
    {
        digits++;
        temp /= 10;
    }
    temp = num;
    while (temp > 0)
    {
        digit = temp % 10;
        sum += (int)pow(digit, digits);
        temp /= 10;
    }
    printf("%d", sum);
    if (sum == orignal)
    {
        printf("Yes it is Armstrong number\n");
    }
    else
    {
        printf("sorry but it is not Armstrong number\n");
    }

    return 0;
}
