#include <stdio.h>
int main(){
    int n,i;
    printf("Read and print elements of a one-dimensional array.\n");
    printf("enter how much long array you want =");
    scanf("%d",&n);
    int arr[n];
    for(i=0;i<n;i++){
        scanf("%d", &arr[i]);
    }
    for(i=0;i<n;i++){
        printf("%d  ",arr[i]);
    }
return 0;
}
