#include <stdio.h>
int main()
{
    printf("Write a program to find the sum of the series: 1 + 3/4 + 5/6 + 7/8 + … up to n terms.\n");
    int i, num;
    float sum=1 ;
    printf("Enter the n terms= ");
    scanf("%d", &num);
    for (i = 2; i <= num; i++)
    {
        sum += (float)(2 * i - 1) / (2 * i);
    }
    printf("sum of terms is %.2f", sum);
    return 0;
}
