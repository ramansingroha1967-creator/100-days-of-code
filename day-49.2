#include <stdio.h>

int main() {
    char str[100];
    int i;

    fgets(str, 100, stdin);

    // Print first initial
    printf("%c.", str[0]);

    // Print initials of middle names
    for (i = 1; str[i] != '\0'; i++) {
        if (str[i - 1] == ' ' && str[i + 1] != '\n' && str[i] != '\n') {
            printf("%c.", str[i]);
        }
    }

    // Find the last space
    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ') {
            printf(" ");
        }
    }

    // Print surname
    int last_space = 0;

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ') {
            last_space = i;
        }
    }

    for (i = last_space + 1; str[i] != '\0' && str[i] != '\n'; i++) {
        printf("%c", str[i]);
    }

    return 0;
}
