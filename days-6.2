#include <stdio.h>
int main(){
    printf("program to input an integer and check whether it is positive, negative or zero.\n");
    int num;
    printf("the number is =");
    scanf("%d", &num);
    if (num>0){
        printf("The number %d is positive", num);
    }
    if(num < 0){
        printf ("the number %d is negative", num);
    }
    else{
        printf("the number is zero", num);
    }
return 0;
}
