#include <stdio.h>

int main() {
    int num, binary[32], i = 0;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num == 0) {
        printf("Binary = 0");
        return 0;
    }

    for (; num > 0; num = num / 2) {
        binary[i] = num % 2;
        i++;
    }

    printf("Binary = ");

    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }

    return 0;
}
