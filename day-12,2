    {
        printf("so you are late for %d days\n",day);
        fine=5*2+5*4+(day-10)*6;
        printf("your fine is =%d",fine);
    }
    else if (day>20)
    {
        printf("your Membership cancelled\n");
    }
    
    else{
        printf("invalid input\n");
    }
    
return 0;
