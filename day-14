#include <stdio.h>
int main(){
    printf("Write a program to print the sum of the first n odd numbers.\n");
    int i,odd,sum,value;
    printf("tell how many terms you want=");
    scanf("%d",&odd);
    i=1;
    while(i<=odd)
    {
        sum=2*i-1;
        printf("%d\n",sum);
        i++;
        value=value+sum;
    }
    printf("value is= %d",value);
return 0;
}
