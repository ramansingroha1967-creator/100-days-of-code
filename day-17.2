 #include <stdio.h>

int main() {
    int num, i = 2, flag = 0;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num <= 1) {
        printf("%d is not a prime number.\n", num);
    } else {
        while (i < num) {
            if (num % i == 0) {
                flag = 1;
                break;
            }
            i++;
        }

        if (flag == 0)
            printf("%d is a prime number.\n", num);
        else
            printf("%d is not a prime number.\n", num);
    }

    return 0;
}
