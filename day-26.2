#include <stdio.h>
int main(){
    printf("Write a program to print the following pattern:\n");
    int i,j;
    for(i=1;i<=3;i++){
        for(j=1;j<=(2*i-1);j++){
            printf("*\n");
        }
        printf("\n");
    }
    for(i=2;i>=1;i--){
        for(j=1;j<=(2*i-1);j++){
            printf("*\n");
        }
        printf("\n");
    }
return 0;
}
