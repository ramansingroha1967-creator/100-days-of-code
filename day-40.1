#include <stdio.h>

int main()
{
    int row, col, i, j;

    printf("Enter number of rows: ");
    scanf("%d", &row);

    printf("Enter number of columns: ");
    scanf("%d", &col);

    int matrix[row][col];

    printf("Enter matrix elements:\n");
    for(i = 0; i < row; i++)
    {
        for(j = 0; j < col; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }

    printf("Diagonal elements are:\n");

    for(i = 0; i < row; i++)
    {
        for(j = 0; j < col; j++)
        {
            if(i == j)
            {
                printf("%d ", matrix[i][j]);
            }
        }
    }

    return 0;
}
