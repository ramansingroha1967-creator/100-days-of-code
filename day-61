
#include <stdio.h>

int main() {
    int n, k;

    printf("Enter array size: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter window size: ");
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("Invalid window size");
        return 0;
    }

    int q[n];
    int front = 0, rear = -1;

    for (int i = 0; i < n; i++) {

        // Remove elements outside the current window
        while (front <= rear && q[front] <= i - k) {
            front++;
        }

        // Store index of negative elements
        if (arr[i] < 0) {
            q[++rear] = i;
        }

        // Print first negative integer of each window
        if (i >= k - 1) {
            if (front <= rear) {
                printf("%d ", arr[q[front]]);
            } else {
                printf("0 ");
            }
        }
    }

    return 0;
}
