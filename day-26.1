#include <stdio.h>
int main(){
    int j,i;
    printf("Write a program to print the following pattern:\n");
    for(i=5;i>=1;i--){
        for(j=1;j<i;j++){
            printf(" ");
        }
        for(j=i;j<=5;j++){
            printf("%d",j);

        }
        printf("\n");
    }
    
return 0;
}
