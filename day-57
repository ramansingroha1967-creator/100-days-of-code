#include <stdio.h>

// Function to find and print the previous greater element for each element
void printPreviousGreater(int arr[], int n) {
    int stack[n];
    int top = -1;

    for (int i = 0; i < n; i++) {
        // Pop elements from the stack that are smaller than or equal to current element
        while (top >= 0 && stack[top] <= arr[i]) {
            top--;
        }

        // If stack is empty, no greater element exists to the left
        if (top == -1) {
            printf("-1 ");
        } else {
            printf("%d ", stack[top]);
        }

        // Push the current element onto the stack
        stack[++top] = arr[i];
    }
    printf("\n");
}

int main() {
    int n;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid array size.\n");
        return 0;
    }

    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Previous Greater Elements: ");
    printPreviousGreater(arr, n);

    return 0;
}
