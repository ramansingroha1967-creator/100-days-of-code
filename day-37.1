#include <stdio.h>

int main()
{
    int row, col, i, j;

    printf("Enter number of rows: ");
    scanf("%d", &row);

    printf("Enter number of columns: ");
    scanf("%d", &col);

    int matrix[row][col];
    int sum[row];

    printf("Enter matrix elements:\n");
    for(i = 0; i < row; i++)
    {
        for(j = 0; j < col; j++)
        {
            scanf("%d", &matrix[i][j]);
        }
    }

    for(i = 0; i < row; i++)
    {
        sum[i] = 0;

        for(j = 0; j < col; j++)
        {
            sum[i] += matrix[i][j];
        }
    }

    printf("Row sums are:\n");
    for(i = 0; i < row; i++)
    {
        printf("Row %d = %d\n", i + 1, sum[i]);
    }

    return 0;
}
