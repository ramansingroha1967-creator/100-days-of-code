#include <stdio.h>
int main()
{
    printf("Find the sum of array elements.\n");
    int n, i, sum = 0;
    printf("enter the n ");
    scanf("%d", &n);
    int arry[n];
    for (i = 0; i <= n - 1; i++)
    {
        scanf("%d", &arry[i]);
    }
    for (i = 0; i <= n - 1; i++)
    {
        sum += arry[i];
    }
    printf("the sum is %d", sum);
    return 0;
}
