#include <stdio.h>
int main()
{
    printf("Write a program to input time in seconds and convert it to hours:minutes:seconds format.\n");
    int hrs, min, sec, totalsec;
    printf("tell total time in second=");
    scanf("%d", &totalsec);
    hrs = totalsec / 3600;
    min = (totalsec % 3600) / 60;
    sec = totalsec % 60;
    printf("The time is =%d:%d:%d", hrs, min, sec);
    return 0;
}
