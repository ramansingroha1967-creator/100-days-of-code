#include <stdio.h>
#include<math.h>
int main(){
    printf("Write a program to find profit or loss percentage given cost price and selling price.\n");
    int profit,loss,cost,sell;
    printf("tell cost prize =");
    scanf("%d",&cost);
    printf("tell selling prize =");
    scanf("%d",&sell);
    float p,l;
    profit= sell-cost;
    
    if (profit>=0)
    {
        printf("the profit=%d\n",profit);
        p=(float)profit/cost*100;
        printf("profit percentage is %.2f", p);
        
    }
    else if (profit<0)
    {
        loss=(-profit);
        printf("the loss=%d\n",loss);
        l=(float)loss/cost*100;
        printf("persentage of loss is %.2f", l);  
    }
    else
    {
        printf("please give correct input\n");
    }
    
    
return 0;
}
