#include <stdio.h>
int main(){
    printf("Write a program to print the sum of the first n even numbers.\n");
    int i,even,sum,value;
    printf("tell how many terms you want=");
    scanf("%d",&even);
    i=1;
    while(i<=even)
    {
        sum=2*i;
        printf("%d\n",sum);
        i++;
        value=value+sum;
    }
    printf("value is= %d",value);
return 0;
}
