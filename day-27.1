#include <stdio.h>
int main(){
    printf("write a program to print the pattern\n");
    int i,j;
    for(i=1;i<=5;i++){
        for(j=1;j<=(2*i-1);j++){
            printf("*");
        }
        printf("\n");
    }
    for(i=4;i>=1;i--){
        for(j=1;j<=(2*i-1);j++){
            printf("*");
        }
        printf("\n");
    }
return 0;
}
