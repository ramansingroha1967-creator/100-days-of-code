#include <stdio.h>

#define MAX 100

void multiplyMatrices(int r1, int c1, int A[MAX][MAX], 
                      int r2, int c2, int B[MAX][MAX], 
                      int C[MAX][MAX]) {
    // Initialize result matrix with zeros
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            C[i][j] = 0;
        }
    }

    // Multiply: C[i][j] = sum(A[i][k] * B[k][j])
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
}

void printMatrix(int r, int c, int mat[MAX][MAX]) {
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            printf("%d\t", mat[i][j]);
        }
        printf("\n");
    }
}

int main() {
    int r1, c1, r2, c2;
    int A[MAX][MAX], B[MAX][MAX], C[MAX][MAX];

    // Input dimensions for Matrix A
    printf("Enter rows and columns for first matrix: ");
    if (scanf("%d %d", &r1, &c1) != 2) return 1;

    // Input dimensions for Matrix B
    printf("Enter rows and columns for second matrix: ");
    if (scanf("%d %d", &r2, &c2) != 2) return 1;

    // Dimension Compatibility Check
    if (c1 != r2) {
        printf("\nError: Matrix multiplication not possible!\n");
        printf("Columns of first matrix (%d) must equal rows of second matrix (%d).\n", c1, r2);
        return 0;
    }

    // Input Matrix A elements
    printf("\nEnter elements of Matrix A (%d x %d):\n", r1, c1);
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c1; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    // Input Matrix B elements
    printf("\nEnter elements of Matrix B (%d x %d):\n", r2, c2);
    for (int i = 0; i < r2; i++) {
        for (int j = 0; j < c2; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Perform Multiplication
    multiplyMatrices(r1, c1, A, r2, c2, B, C);

    // Display Result
    printf("\nResultant Matrix C (%d x %d):\n", r1, c2);
    printMatrix(r1, c2, C);

    return 0;
}
