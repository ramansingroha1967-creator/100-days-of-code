#include <stdio.h>

int main() {
    printf("Write a program to reverse a given number.  tell error\n");
    int num, rev = 0, rem;

    printf("Enter your number: ");
    scanf("%d", &num);

    while (num != 0) {
        rem = num % 10;
        rev = rev * 10 + rem;
        num = num / 10;
    }

    printf("Reversed number is = %d", rev);

    return 0;
}
