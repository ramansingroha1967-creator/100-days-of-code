#include <stdio.h>
int main(){
    printf("Write a program to check if a number is a perfect number.\n");
    int num,i,sum=0;
    printf("Enter the number= ");
    scanf("%d",&num);
    for(i=1;i<num;i++){
        if(num%i==0){
            sum +=i;
        }
    }
    if(sum==num){
        printf("This is perfect number\n");
    }
    else{
        printf("This is not prefect number\n");
    }
return 0;
}
