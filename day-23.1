#include <stdio.h>
int main()
{
    printf("Write a program to find the sum of the series: 2/3 + 4/7 + 6/11 + 8/15 + ... up to n terms.\n");
    int num, i = 1;
    float sum = 0;
    printf("enter nth term value= ");
    scanf("%d", &num);
    while (i <= num)
    {
        sum += (float)(2 * i) / (4 * i - 1);
        i++;
    }
    printf("sum till %dth term =%.2f", num, sum);
    return 0;
}
